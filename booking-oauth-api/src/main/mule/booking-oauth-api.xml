<?xml version="1.0" encoding="UTF-8"?>
<mule
    xmlns="http://www.mulesoft.org/schema/mule/core"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:http="http://www.mulesoft.org/schema/mule/http"
    xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
    xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
    xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
    xmlns:oauth2-provider="http://www.mulesoft.org/schema/mule/oauth2-provider"
    xmlns:api-gateway="http://www.mulesoft.org/schema/mule/api-gateway"
    xmlns:os="http://www.mulesoft.org/schema/mule/os"

    xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/oauth2-provider http://www.mulesoft.org/schema/mule/oauth2-provider/current/mule-oauth2-provider.xsd
        http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
        http://www.mulesoft.org/schema/mule/api-gateway http://www.mulesoft.org/schema/mule/api-gateway/current/mule-api-gateway.xsd">
	
	<http:listener-config
		name="booking-oauth-api-httpListenerConfig"
	>
		<http:listener-connection
			host="0.0.0.0"
			port="8081" />
	</http:listener-config>
	
	<os:object-store
		name="client_object_store"
		doc:name="Object store"
		doc:id="4878bc10-ca6d-46b5-8114-302e97a4b413" />
	<os:object-store
		name="Object_store"
		doc:name="Object store"
		doc:id="e55cadff-4c05-4584-9904-2edc922ada0f" />
	<api-gateway:autodiscovery apiId="2788373" ignoreBasePath="true" doc:name="API Autodiscovery" doc:id="b940f3c8-d429-4181-97fe-a909c307460c" flowRef="get:\booking\BID7890" />
	<flow name="get:\booking\BID7890">
		<http:listener doc:name="Listener" doc:id="637770c6-b2af-46a0-ba62-1dcd39bd4a9a" config-ref="booking-oauth-api-httpListenerConfig" path="/booking/BID7890"/>
		<ee:transform doc:name="Transform Message">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  booking_id: "BID7890",
  cinema: {
    cinema_id: 34458,
    cinema_name: "Acme IMAX",
    address: "Rd No. 67, Acme Circle",
    city: "Hyderabad",
    country: "India",
    postcode: "500061",
    screen_name: "Audi 7",
    seats: "RR - H4"
  },
  film: {
    film_name: "Avengers - Infinity War",
    language: "English",
    duration_mins: 175,
    distributor_id: 427,
    distributor: "Super International",
    imdb_rating: 8.9,
    comic: "MARVEL",
    showing: [
      {
        date_time: "2022-10-08T13:55:00+05:30"
      }
    ]
  },
  user: {
    name: "Sid",
    mobile: "+91 98765 43210",
    preferred_genre: [
      "Sci-Fi", 
      "Thriller"
    ]
  },
  status: {
    state: "OK",
    method: "cinemaDetails",
    message: null,
    request_method: "GET",
    version: "v200"
  }
} as Object {encoding: "UTF-8", mediaType: "application/json"}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</flow>
	<flow name="get:\booking\live">
		<http:listener doc:name="Listener" doc:id="57478a6c-b736-4df8-83a1-5e9550ad84e8" config-ref="booking-oauth-api-httpListenerConfig" path="/booking/live"/>
		<ee:transform doc:name="Transform Message">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
"Live" as String {encoding: "UTF-8", mediaType: "application/json"}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</flow>
	<flow
		name="post:\booking\register"
	>
		<http:listener doc:name="Listener" doc:id="2af997f5-93bd-47c5-8b88-69ea0360e8d6" config-ref="booking-oauth-api-httpListenerConfig" path="/booking/register"/>
		<set-payload
			value='#["Callback URL Registered - " ++ payload.callBackURL as String]'
			doc:name="Set Payload"
			doc:id="53fa7112-f9d1-43d9-b75c-5cb4b59af9b3" />
	</flow>
	<oauth2-provider:config
		name="OAuth2_Provider_Config"
		doc:name="OAuth2 Provider Config"
		doc:id="aa11c685-acdb-4366-aa0e-1ccf5e23186f"
		listenerConfig="booking-oauth-api-httpListenerConfig"
		clientStore="client_object_store"
		supportedGrantTypes="CLIENT_CREDENTIALS"
	>
		<oauth2-provider:token-config
			tokenStore="Object_store" />
	</oauth2-provider:config>
	<flow
		name="AutoCreate-Oauth-Client-Flow"
		doc:id="2f01ddaf-55ca-4f29-9d91-fca0512464d8"
	>
		<scheduler
			doc:name="Scheduler"
			doc:id="3b520509-141f-4506-90cc-c96fab1d923d"
		>
			<scheduling-strategy>
				<fixed-frequency
					frequency="365"
					timeUnit="DAYS" />
			</scheduling-strategy>
		</scheduler>
		<http:request
			method="GET"
			doc:name="Request"
			doc:id="a3dfedd2-75ca-43c6-a9b3-df4d771765d2"
			url="http://localhost:8081/createclient"
		>
			<http:headers><![CDATA[#[output application/java
---
{
	"client_secret" : "mcd-l2-client_secret",
	"grant_type" : "client_credentials",
	"client_id" : "mcd-l2-client_id"
}]]]></http:headers>
		</http:request>
		<logger
			level="INFO"
			doc:name="Logger"
			doc:id="7a15b3c9-d6c8-438f-a861-830a762ee34c"
			message='#[payload]' />
	</flow>
	<flow
		name="createClient"
		doc:id="e56bbf1d-57ac-4b69-9f9d-269994ad72fc"
	>
		<http:listener
			doc:name="Listener"
			doc:id="602a7cea-c356-4667-ba63-0c1bd3e489b2"
			config-ref="booking-oauth-api-httpListenerConfig"
			path="/createclient" />
		<oauth2-provider:create-client
			doc:name="Create client"
			doc:id="1a379cdb-2182-45de-828e-b00cbd2c4e98"
			config-ref="OAuth2_Provider_Config"
			clientId="#[attributes.headers.client_id]"
			type='CONFIDENTIAL'
			secret="#[attributes.headers.client_secret]"
			clientName="#[attributes.headers.client_name]"
			redirectUris='#[["demo.com"]]'
			authorizedGrantTypes='#[["CLIENT_CREDENTIALS"]]'
			description='#[""]'
			principal='#[""]'
			scopes='#[[]]'
			failIfPresent="true" />
		<logger
			level="INFO"
			doc:name="Logger"
			doc:id="2e77195f-5918-4e91-950c-278f99bc088a"
			message="#[payload]" />
		<set-payload
			value="============================== Client Created Successfully =============================="
			doc:name="Response"
			doc:id="78dbd1fc-c5bf-489e-b821-39495c7a88ff" />
	</flow>
	<flow
		name="validateToken"
		doc:id="fde401de-f7bc-43b1-8ef2-a636a2cfcfae"
	>
		<http:listener
			doc:name="Listener"
			doc:id="3329428e-eb3d-463d-9467-7da0fea6496a"
			config-ref="booking-oauth-api-httpListenerConfig"
			path="/validateToken" />
		<oauth2-provider:validate-token
			doc:name="Validate token"
			doc:id="0e319940-0b98-45f9-9b53-209458615660"
			config-ref="OAuth2_Provider_Config" />
		<set-payload
			value="#[payload]"
			doc:name="Set Payload"
			doc:id="b4b76067-abdf-4e59-9d6d-a5f8da284f6a" />
	</flow>
</mule>
