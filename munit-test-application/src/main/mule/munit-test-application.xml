<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd 
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd">

	<http:listener-config name="HTTP_Listener_config"
		doc:name="HTTP Listener config"
		doc:id="d78de82f-e3cb-4194-88f4-15a6f94d4c78">
		<http:listener-connection host="0.0.0.0" port="8081" />
	</http:listener-config>

	<configuration-properties
		doc:name="Configuration properties"
		doc:id="450dd358-5965-4a10-b79e-806c14c18f85"
		file="properties-${env}.yaml" />

	<flow name="httpbin-flow" doc:id="131b9519-4128-466c-af38-45c9d7e88ab3">
		<http:request method="GET"
			doc:name="HTTPBin - Status Code"
			doc:id="c7b3df16-0f4c-40cc-ac5e-a236f3b148ee"
			url="${httpbin.protocol}://${httpbin.host}${httpbin.path}/{httpCode}"
			target="httpBin">
			<error-mapping sourceType="HTTP:FORBIDDEN" targetType="APP:TESTING_FORBIDDEN" />
			<http:uri-params><![CDATA[#[output application/java
---
{
	"httpCode" : vars.statusCode default "200"
}]]]></http:uri-params>
		</http:request>
		<error-handler>
			<on-error-propagate enableNotifications="true"
				logException="true" doc:name="On Error Propagate"
				doc:id="7b68cd35-f67f-4a7e-b245-2f8719578445"
				type="APP:TESTING_FORBIDDEN">
				<set-payload value="Testing Forbidden"
					doc:name="Testing Forbidden"
					doc:id="525e5928-b7ce-4c50-8785-819eb9c6a3c7" />
				<set-variable value="403" doc:name="httpStatusCode"
					doc:id="a97cd885-d946-45c6-a515-8f4c2be280b7"
					variableName="httpStatusCode" />
			</on-error-propagate>
		</error-handler>
	</flow>

	<flow name="reqres-flow" doc:id="2f1d2afa-676e-4a16-9b75-c3b7ef170376">
		<ee:transform doc:name="Prepare ReqRes Payload" doc:id="31524f15-8f1f-4d46-8c0e-c87f552f5156">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	"name": if (payload.fname != null) (payload.fname ++ " " ++ payload.lname) else (payload.name default "Morpheus"),
	"job": payload.role default payload.job default "Leader"
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<http:request method="POST"
			doc:name="ReqRes - Create User API"
			doc:id="9059b5ac-5b2e-4087-9ea6-003cd3877845"
			url="${reqres.protocol}://${reqres.host}${reqres.path}"
			target="reqres">
			<http:headers><![CDATA[#[{
		"x-api-key": p('reqres.api_key'),
		"Content-Type": "application/json"
	}]]]></http:headers>
		</http:request>
	</flow>

	<flow name="quotes-flow" doc:id="4dff6736-9ca7-4858-ba77-0c2b2a1d3eea">
		<http:request method="GET" doc:name="Quotes - Random"
			doc:id="d8da740f-b3b9-480d-9661-991bd7b41602"
			url="${quotes.protocol}://${quotes.host}${quotes.path}"
			target="quotes" />
	</flow>

	<flow name="mashup-flow" doc:id="2f236fdd-ec81-4882-9c8b-4fa38d99f348">
		<http:listener doc:name="Listener"
			doc:id="f2e8ffc9-e811-40c4-be1d-1d523a8965e0"
			config-ref="HTTP_Listener_config" path="/testing">
			<http:error-response statusCode="#[vars.httpStatusCode default 500]">
				<http:body><![CDATA[#[payload]]]></http:body>
			</http:error-response>
		</http:listener>
		<set-variable
			value="#[attributes.queryParams.statusCode default '200']" doc:name="StatusCode"
			doc:id="5b8fb8eb-a9d4-4f5c-9100-a8fcfaf45568"
			variableName="statusCode" />
		<flow-ref doc:name="reqres-flow"
			doc:id="41dc9063-b5aa-41fb-b790-d88faaa19b57" name="reqres-flow" />
		<flow-ref doc:name="quotes-flow"
			doc:id="98bb763f-f272-414d-bc8e-d323811e98cf" name="quotes-flow" />
		<flow-ref doc:name="httpbin-flow"
			doc:id="5b3bd207-a525-4b99-a48c-6cf3a9c71742" name="httpbin-flow" />
		<ee:transform doc:name="Final Response"
			doc:id="3c12069c-59ae-43c1-ba8c-91f8f34b5e2a">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	name: vars.reqres.name default "Morpheus",
	job: upper(vars.reqres.job default "Leader"),
	quote: vars.quotes.quote default "",
	status: vars.statusCode as Number default 200
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</flow>
</mule>