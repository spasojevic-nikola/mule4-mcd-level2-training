<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
	xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools  http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">
	<munit:config name="munit-test-suite.xml" />
	<sub-flow name="mock-when-subflow" doc:id="797ac0a8-65a5-4521-b34c-56b66361026d" >
		<munit-tools:mock-when doc:name="ReqRes Mock" doc:id="82bfa730-94e4-4e0a-a946-b28ffcfb91f9" processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="9059b5ac-5b2e-4087-9ea6-003cd3877845" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:variables>
						<munit-tools:variable key="reqres" value="#[output application/json --- testMockData::reqresResponse]" mediaType="application/json" />
					</munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		<munit-tools:mock-when doc:name="Quotes Mock" doc:id="db66539d-8df3-4c89-bb0e-e12a79791b97" processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="d8da740f-b3b9-480d-9661-991bd7b41602" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:variables>
						<munit-tools:variable key="quotes" value="#[output application/json --- testMockData::quotesResponse]" mediaType="application/json" />
					</munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		<munit-tools:mock-when doc:name="HttpBin Mock" doc:id="33fc7f10-bf54-4bcb-b647-b4b4d0765052" processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="c7b3df16-0f4c-40cc-ac5e-a236f3b148ee" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:variables>
						<munit-tools:variable key="httpBin" value="#['']" />
					</munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>
	</sub-flow>
	<munit:test name="munit-test-success-path"
		doc:id="b4e4e2c2-46a6-4b3c-8fc3-7d55e48026a7" tags="UNIT-TEST"
		description="Testing the mashup flow for success responses">
		<munit:behavior>
			<flow-ref doc:name="mock-when-subflow" doc:id="f7849632-ea25-43f2-9e3e-abbd1d6aad0a" name="mock-when-subflow" />
			<munit-tools:spy doc:name="Spy - ReqRes"
				doc:id="ad1c067b-c2ea-4560-a1c7-eb276c8e6a7c"
				processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute
						whereValue="9059b5ac-5b2e-4087-9ea6-003cd3877845"
						attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:before-call>
					<munit-tools:assert-that
						doc:name="Assert Input Payload"
						doc:id="6e9fb1e0-8c8f-43ab-ba99-88737ac3abcc"
						is="#[MunitTools::equalTo(testMockData::reqresRequest)]"
						expression="#[payload]"
						message="Spy Failed - No Input Payload Found" />
				</munit-tools:before-call>
				<munit-tools:after-call>
					<munit-tools:assert-that
						doc:name="Assert Response Payload"
						doc:id="928f14f6-3984-4be8-8176-a3b645ac8c06"
						expression="#[vars.reqres]"
						is="#[MunitTools::equalTo(testMockData::reqresResponse)]"
						message="Spy Failed - Response doesn't match" />
				</munit-tools:after-call>
			</munit-tools:spy>
		</munit:behavior>
		<munit:execution>
			<munit:set-event
				doc:name="Set Payload and Query Param"
				doc:id="ccdab4c6-cfc4-443b-a5ab-ba7a40c13c08">
				<munit:payload
					value="#[output application/json --- testMockData::reqresRequest]" />
				<munit:attributes
					value="#[{queryParams:{statusCode:testMockData::attributesStatusCode}}]" />
			</munit:set-event>
			<flow-ref doc:name="mashup-flow"
				doc:id="f7039125-7a75-418a-b9c1-11ec68c59e27" name="mashup-flow" />
		</munit:execution>
		<munit:validation>
			<munit-tools:verify-call
				doc:name="Verify ReqRes"
				doc:id="99f172d1-1faa-4478-9f5b-608808294dbb"
				processor="http:request" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute
						whereValue="9059b5ac-5b2e-4087-9ea6-003cd3877845"
						attributeName="doc:id" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
			<munit-tools:verify-call
				doc:name="Verify HttpBin"
				doc:id="94a5cc2c-3ede-499b-95ac-f55ba5084108"
				processor="http:request" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute
						whereValue="c7b3df16-0f4c-40cc-ac5e-a236f3b148ee"
						attributeName="doc:id" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
			<munit-tools:verify-call
				doc:name="Verify Quotes"
				doc:id="fa4bda27-15a6-4ceb-8129-016c1354a786"
				processor="http:request" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute
						whereValue="d8da740f-b3b9-480d-9661-991bd7b41602"
						attributeName="doc:id" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
			<munit-tools:assert-that
				doc:name="Assert that Payload is NOT Null"
				doc:id="27d42290-1582-4106-a284-2cf0355e5261"
				expression="#[payload]" is="#[MunitTools::notNullValue()]"
				message="Payload is null" />
			<munit-tools:assert-that
				doc:name="Assert that Payload Name field is Concatanated"
				doc:id="d0966f6e-0b55-45c0-8456-b32f4b723a0d"
				expression="#[payload.name]"
				is="#[MunitTools::equalTo('Chuck Norris')]"
				message="Payload name is not properly concatanated as expected" />
			<munit-tools:assert-that
				doc:name="Assert Mashup Response"
				doc:id="f58d24c5-6127-476f-9bf7-ff1646db8481"
				is="#[MunitTools::equalTo(testMockData::mashupResponse)]"
				expression="#[payload]"
				message="Assertion failed in mashup response" />
		</munit:validation>
	</munit:test>
	<munit:test name="munit-testing-error" doc:id="b5df3c32-21df-4381-b818-47e16f869700" description="Testing a Flow with On-Error_propagate" tags="ERROR-TEST" expectedErrorType="APP:TESTING_FORBIDDEN">
		<munit:behavior >
			<munit-tools:mock-when doc:name="Mock Error" doc:id="36d151fb-113b-429b-a714-805014269a03" processor="http:request">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="c7b3df16-0f4c-40cc-ac5e-a236f3b148ee" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:error typeId="APP:TESTING_FORBIDDEN" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<flow-ref doc:name="Flow Reference" doc:id="c95085e0-cdd8-4831-8a5b-edb121f9273a" name="httpbin-flow"/>
		</munit:execution>
	</munit:test>
</mule>
